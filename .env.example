# LLM API 配置 (阿里云百炼或 OpenAI 兼容接口)
AL_BAILIAN_API_KEY=your_api_key_here
AL_BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ORCHESTRATOR_MODEL_NAME=qwen-max
TECHNICAL_MODEL_NAME=qwen-plus-2025-09-11
SERVICE_MODEL_NAME=qwen3.8-flash

# 数据库配置 (MySQL)
# docker-compose 部署时 MYSQL_HOST/REDIS_HOST 由 compose 自动设为容器名，此处仅本地开发用
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=its_secure_2024
MYSQL_DATABASE=its

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379

# 知识库配置
KNOWLEDGE_BASE_URL=http://127.0.0.1:8001
EMBEDDING_MODEL=text-embedding-v4
# knowledge 服务 RAG 生成模型
MODEL=qwen-max
# 检索精度过滤阈值：候选余弦相似度低于该值被剔除（调高=更严格更准，调低=更宽松更全）
CONTEXT_SIM_THRESHOLD=0.35
# 硬地板：全部候选低于阈值时，若最高分仍低于该值，判定知识库无相关内容返回空上下文
CONTEXT_SIM_HARD_FLOOR=0.25
# LLM 相关性剔除（主题漂移兜底）：用非思考快模型做标题级判别
RERANK_ENABLED=true
RERANK_MODEL=qwen-plus-2025-09-11

# 外部服务 API 配置 (百度地图双 AK)
# 服务端 AK: 后端地理编码/POI检索/路网距离
BAIDU_MAP_AK=your_baidu_map_ak_here
# 浏览器端 AK: 前端 JS API 浏览器定位 (百度控制台需创建"浏览器端"类型 AK 并勾选 JavaScript API 服务)
BAIDU_MAP_AK_BROWSER=your_baidu_map_browser_ak_here

# LangSmith 可观测性配置 (可选)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=its-multi-agent
